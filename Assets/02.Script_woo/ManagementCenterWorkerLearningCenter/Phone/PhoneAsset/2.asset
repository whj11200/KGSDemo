  lines:
  - side: 1
    speaker: 
    message: "\uD1B5\uC81C\uC18C, \u25CB\u25CB\uAD00\uB9AC\uC18C\uC785\uB2C8\uB2E4.\r\nM-31~M21A
      \uAD6C\uAC04 \uBC38\uBE0C \uCC28\uB2E8 \uC644\uB8CC\uD588\uC2B5\uB2C8\uB2E4."
  - side: 0
    speaker: "\uD1B5\uC81C\uC18C \uB2F4\uB2F9\uC790"
    message: "\uC794\uB958\uAC00\uC2A4 \uBC29\uC0B0 \uC808\uCC28 \uC9C4\uD589\uD558\uACA0\uC2B5\uB2C8\uB2E4.\r\n\uBC29\uC0B0
      \uC2DC\uAC04\uC740 10\uBD84\uC73C\uB85C \uD310\uB2E8\uB429\uB2C8\uB2E4.\r\n\uC548\uC804\uC704\uCE58\uB85C
      \uC774\uB3D9 \uBC14\uB78D\uB2C8\uB2E4."
  - side: 1
    speaker: 
    message: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4.\r\n\uC791\uC5C5\uC790 \uC548\uC804\uC704\uCE58
      \uC774\uB3D9 \uD6C4 \uBCF4\uACE0\uD558\uACA0\uC2B5\uB2C8\uB2E4."
