  lines:
  - side: 1
    speaker: 
    message: "\u25CB\u25CB\uAD00\uB9AC\uC18C\uC785\uB2C8\uB2E4.\r\nM-31~M-21A \uAD6C\uAC04
      \uBC38\uBE0C\n\uC815\uC0C1\uD654 \uC644\uB8CC\uD588\uC2B5\uB2C8\uB2E4."
  - side: 0
    speaker: "\uD1B5\uC81C\uC18C \uB2F4\uB2F9\uC790"
    message: "\uACC4\uCE21\uAC12 \uC815\uC0C1 \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uACBD\uBCF4
      \uC7AC\uBC1C\uC0DD\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC815\uC0C1 \uAC10\uC2DC
      \uC0C1\uD0DC\uB85C \uBCF5\uADC0\uBC14\uB78D\uB2C8\uB2E4."
  - side: 1
    speaker: 
    message: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4.\r\n\uC815\uC0C1 \uAC10\uC2DC \uC0C1\uD0DC\uB85C
      \uBCF5\uADC0\uD558\uACA0\uC2B5\uB2C8\uB2E4."
