  lines:
  - side: 0
    speaker: "\uD1B5\uC81C\uC18C \uAD00\uB9AC\uC790"
    message: "\u25CB\u25CB\uAD00\uB9AC\uC18C\uC5D0 \uAC00\uC2A4\uB204\uCD9C \uACBD\uBCF4\uAC00\n\uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4."
  - side: 1
    speaker: 
    message: "\uC704\uCE58 \uD655\uC778 \uBC14\uB78D\uB2C8\uB2E4."
  - side: 0
    speaker: "\uD1B5\uC81C\uC18C"
    message: "\uC815\uC555\uB77C\uC778 \uC778\uADFC\uC785\uB2C8\uB2E4.\r\n\uD604\uC7A5
      \uC811\uADFC \uAC00\uB2A5 \uC5EC\uBD80\uB97C \uD655\uC778\uD574 \uC8FC\uC138\uC694."
  - side: 1
    speaker: 
    message: "\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uC8FC\uBCC0 \uC548\uC804 \uD655\uC778\uD558\uC5EC\n\uC811\uADFC
      \uD6C4 \uBCF4\uACE0\uD558\uACA0\uC2B5\uB2C8\uB2E4."
