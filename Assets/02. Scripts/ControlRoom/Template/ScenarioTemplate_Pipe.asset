MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 691fd311eb1169346860073522a9f768, type: 3}
  m_Name: ScenarioTemplate_Pipe
  m_EditorClassIdentifier: Assembly-CSharp::PipelineScenarioTemplate
  ScenarioType: 1
  Nodes:
  - Speaker: 
    Content: "\uACF5\uAE09\uAD00\uB9AC\uC18C\uAC04 \uBC30\uAD00 \uC190\uC0C1\uC73C\uB85C
      \uAC00\uC2A4 \uB204\uCD9C\uC774 \r\n\uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 35cc830bd8fb4de418533b1b21911a09, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "\uBA54\uC2DC\uC9C0\uB97C \uD655\uC778\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: 8bfa6927ad2765441b12a6c6f1810a26, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uB204\uCD9C \uC704\uCE58\uAC00 \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uCD08\uAE30
      \uB300\uC751 \uC808\uCC28\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 466304ecfd8325043ab876c94511abbe, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "\uC548\uC804 \uCC45\uC784\uC790\uC5D0\uAC8C \uC0C1\uD669\uC744 \uBCF4\uACE0\uD558\uACE0\n\uAE34\uAE09
      \uC870\uCE58\uB97C \uC694\uCCAD\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: 6201933daa7758448b79d028eed675f1, type: 3}
    NoCondition: 0
  - Speaker: "\uC548\uC804 \uCC45\uC784\uC790"
    Content: "\uAC00\uC2A4\uACF5\uAE09 \uC911\uB2E8 \uBC0F \uBC29\uC0B0\uD0D1 \uBC29\uCD9C\uC774
      \uD544\uC694\uD569\uB2C8\uB2E4.\n\uBC29\uC0B0\uBC38\uBE0C \uAC1C\uD3D0\uC0C1\uD0DC\uB97C
      \uD655\uC778\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: 94d04a31e4542eb4893e8f3bc0faad77, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uAD6C\uAC04\uCC28\uB2E8\uC744 \uC2E4\uC2DC\uD569\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: d644f1cc75a854a41a0c3c859f2d5356, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uBC29\uC0B0\uB77C\uC778 \uBC38\uBE0C \uC791\uB3D9 \uBC0F \uBC29\uC0B0\uC744
      \uC2DC\uC791\uD569\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: d03e29dc60810c14f9e7724271540e2d, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "\uAC00\uC2A4 \uBC29\uCD9C \uC644\uB8CC\uAE4C\uC9C0 \uB300\uAE30\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: 00bad3d974c9b464d86d56949f9cc2c3, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uAD00\uB9AC\uC18C\uAC04 \uBC30\uAD00\uC5D0 \uC190\uC0C1\uC774 \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: b950784c5a1b8ea499b60ce4db95aa57, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "\uAE34\uAE09 \uBCF5\uAD6C\uBC18\uC774 \uD604\uC7A5\uC5D0 \uCD9C\uB3D9\uD558\uC5EC\n\uBCF5\uAD6C
      \uC791\uC5C5\uC744 \uC9C4\uD589 \uC911\uC785\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 7197edfbf3e82c741b3e6720a75f06e2, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uACF5\uAE09\uB9DD \uC815\uC0C1\uD654 \uC808\uCC28\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uCC28\uB2E8\uB41C
      \uBC38\uBE0C\uB97C \uC21C\uCC28\uC801\uC73C\uB85C \uC870\uC791\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: 141f8ce91fc12e3438ae738f5afa0b9f, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uBC29\uC0B0\uB77C\uC778 \uBC38\uBE0C \uAC1C\uBC29 \uC0C1\uD0DC\uB97C
      \uCD5C\uC885 \uD655\uC778\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: e06a3f1d41b4eeb4c9bb9d35c2ed3807, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uACF5\uAE09\uB9DD \uC815\uC0C1\uD654 \uC808\uCC28\uB97C \uC644\uB8CC\uD558\uC600\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 3c0de87459987a9489d322e7ac04b56d, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "\uACF5\uAE09\uC18C\uAC04 \uBC30\uAD00 \uC190\uC0C1 \uBC0F\n\uB204\uCD9C
      \uB300\uC751 \uD6C8\uB828\uC744 \uC885\uB8CC\uD569\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 87dc15893b308db48b298057019093f3, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "\uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: de2391007a2c94341a5ee556f489cb5c, type: 3}
    NoCondition: 1
  VentValves: []
  WaitTime: 30
