  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00be476b437588541a8a509af5eaeceb, type: 3}
  m_Name: ScenarioTemplate_Facility
  m_EditorClassIdentifier: Assembly-CSharp::FacilityScenarioTemplate
  ScenarioType: 0
  Nodes:
  - Speaker: 
    Content: "\uAD00\uB9AC\uC18C \uB0B4\uC5D0\uC11C \uB204\uCD9C\uC774 \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uB204\uC124
      \uACBD\uBCF4\uAE30\uAC00 \uC791\uB3D9 \uC911\uC785\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 17fcff5df54fe3b42a0fbb1029621b6d, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "\uBA54\uC2DC\uC9C0\uB97C \uD655\uC778\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: 8bfa6927ad2765441b12a6c6f1810a26, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uB204\uCD9C \uC704\uCE58 \uBC0F \uAC00\uC2A4 \uB18D\uB3C4\uAC00 \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 466304ecfd8325043ab876c94511abbe, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "\uD3ED\uBC1C\uD558\uD55C\uACC4 20\uD37C\uC13C\uD2B8 \uCD08\uACFC \uB18D\uB3C4\uAC00
      \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 99bff48ccdccf064e8c502af6c1ed572, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "\uCD08\uAE30 \uB300\uC751 \uC808\uCC28\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 8820ec63816166f4bb3058a68d9c2e81, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "\uC548\uC804 \uCC45\uC784\uC790\uC5D0\uAC8C \uC0C1\uD669\uC744 \uBCF4\uACE0\uD558\uACE0\n\uAE34\uAE09
      \uC870\uCE58\uB97C \uC694\uCCAD\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: 6201933daa7758448b79d028eed675f1, type: 3}
    NoCondition: 0
  - Speaker: "\uC548\uC804 \uCC45\uC784\uC790"
    Content: "\uAC00\uC2A4\uACF5\uAE09 \uC911\uB2E8 \uBC0F \uC18C\uB0B4 \uBC29\uCD9C\uC774
      \uD544\uC694\uD569\uB2C8\uB2E4.\r\n\uC720\uAD00\uAE30\uAD00 \uC2E0\uACE0 \uBC0F
      \uD611\uC870 \uC694\uCCAD\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 13a63acbae783cf45b23348535e44bec, type: 3}
    NoCondition: 1
  - Speaker: "\uC548\uC804 \uCC45\uC784\uC790"
    Content: "\uB204\uCD9C \uC9C0\uC810 \uC778\uADFC\uC758 \uBAA8\uB4E0 \uBC38\uBE0C\uB97C
      \uCC28\uB2E8\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: 7cc4c6b26ca95b74d9fe12b99faef02a, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uAD00\uB0B4 \uC794\uB958 \uAC00\uC2A4 \uBC29\uCD9C \uC644\uB8CC\uAE4C\uC9C0
      \uB300\uAE30\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: a8e8927fe4450a647a7b18533a59e291, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "{Part} \uC190\uC0C1\uC774 \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 0}
    NoCondition: 1
  - Speaker: 
    Content: "\uAE34\uAE09 \uBCF5\uAD6C\uBC18\uC774 \uD604\uC7A5\uC5D0 \uCD9C\uB3D9\uD558\uC5EC\r\n\uBCF5\uAD6C
      \uC791\uC5C5\uC744 \uC9C4\uD589 \uC911\uC785\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 7197edfbf3e82c741b3e6720a75f06e2, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uACF5\uAE09\uB9DD \uC815\uC0C1\uD654 \uC808\uCC28\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uCC28\uB2E8\uB41C
      \uBC38\uBE0C\uB97C \uC21C\uCC28\uC801\uC73C\uB85C \uC7AC\uAC1C\uBC29\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: 141f8ce91fc12e3438ae738f5afa0b9f, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uBC29\uC0B0\uB77C\uC778 \uBC38\uBE0C \uAC1C\uBC29 \uC0C1\uD0DC\uB97C
      \uCD5C\uC885 \uD655\uC778\uD558\uC138\uC694."
    Voice: {fileID: 8300000, guid: 102305b5ec2ae4c47b7dcfe08b88694b, type: 3}
    NoCondition: 0
  - Speaker: 
    Content: "\uACF5\uAE09\uB9DD \uC815\uC0C1\uD654 \uC808\uCC28\uB97C \uC644\uB8CC\uD558\uC600\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 3c0de87459987a9489d322e7ac04b56d, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "{Title} \uB204\uCD9C \uB300\uC751 \uD6C8\uB828\uC744 \uC885\uB8CC\uD569\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: 7b43077725d06bc46bf9ef21a3936c18, type: 3}
    NoCondition: 1
  - Speaker: 
    Content: "\uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 8300000, guid: de2391007a2c94341a5ee556f489cb5c, type: 3}
    NoCondition: 1
