  m_Script: {fileID: 11500000, guid: 00be476b437588541a8a509af5eaeceb, type: 3}
  m_Name: ScenarioTemplate_Facility
  m_EditorClassIdentifier: Assembly-CSharp::FacilityScenarioTemplate
  ScenarioType: 0
  Nodes:
  - Content: "\uAD00\uB9AC\uC18C \uB0B4\uC5D0\uC11C \uB204\uCD9C\uC774 \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 0}
    NoCondition: 1
  - Content: "\uB204\uC124 \uACBD\uBCF4\uAE30\uAC00 \uC791\uB3D9 \uC911\uC785\uB2C8\uB2E4."
    Voice: {fileID: 0}
    NoCondition: 0
  - Content: "\uB204\uCD9C \uC704\uCE58\uAC00 \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uCD08\uAE30
      \uB300\uC751 \uC808\uCC28\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4."
    Voice: {fileID: 0}
    NoCondition: 1
  - Content: "\uB204\uCD9C\uAC00\uC2A4 \uB18D\uB3C4\uB97C \uD655\uC778\uD558\uC2ED\uC2DC\uC624."
    Voice: {fileID: 0}
    NoCondition: 0
  - Content: "\uD3ED\uBC1C\uD558\uD55C\uACC4 20\uD37C\uC13C\uD2B8 \uCD08\uACFC \uB18D\uB3C4\uAC00
      \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 0}
    NoCondition: 1
  - Content: "\uD1B5\uC81C\uC18C\uC5D0 \uC0C1\uD669\uC744 \uBCF4\uACE0\uD558\uACE0
      \uAE34\uAE09 \uC870\uCE58\uB97C \uC694\uCCAD\uD558\uC138\uC694."
    Voice: {fileID: 0}
    NoCondition: 0
  - Content: "\uAC00\uC2A4\uACF5\uAE09 \uC911\uB2E8 \uBC0F \uC18C\uB0B4 \uBC29\uCD9C\uC774
      \uD544\uC694\uD569\uB2C8\uB2E4.\r\n\uC720\uAD00\uAE30\uAD00 \uC2E0\uACE0 \uBC0F
      \uD611\uC870\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    Voice: {fileID: 0}
    NoCondition: 0
  - Content: "\uB204\uCD9C \uC9C0\uC810 \uC778\uADFC\uC758 \uBAA8\uB4E0 \uBC38\uBE0C\uB97C
      \uCC28\uB2E8\uD558\uC138\uC694."
    Voice: {fileID: 0}
    NoCondition: 0
  - Content: "\uAD00\uB0B4 \uC794\uB958 \uAC00\uC2A4 \uBC29\uCD9C \uC644\uB8CC\uAE4C\uC9C0
      \uB300\uAE30\uD558\uC138\uC694."
    Voice: {fileID: 0}
    NoCondition: 0
  - Content: "\uAC00\uC2A4 \uD544\uD130 \uC190\uC0C1\uC774 \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    Voice: {fileID: 0}
    NoCondition: 1
  - Content: "\uAE34\uAE09 \uBCF5\uAD6C\uBC18\uC774 \uD604\uC7A5\uC5D0 \uCD9C\uB3D9\uD558\uC5EC\r\n\uBCF5\uAD6C
      \uC791\uC5C5\uC744 \uC9C4\uD589 \uC911\uC785\uB2C8\uB2E4."
    Voice: {fileID: 0}
    NoCondition: 0
  - Content: "\uACF5\uAE09\uB9DD \uC815\uC0C1\uD654 \uC808\uCC28\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uCC28\uB2E8\uB41C
      \uBC38\uBE0C\uB97C \uC21C\uCC28\uC801\uC73C\uB85C \uC7AC\uAC1C\uBC29\uD558\uC138\uC694."
    Voice: {fileID: 0}
    NoCondition: 0
  - Content: "M-51P, M-52P \uBCA4\uD2B8\uC758 \uAC1C\uBC29 \uC0C1\uD0DC\uB97C \uB2E4\uC2DC
      \uD655\uC778\uD558\uC138\uC694."
    Voice: {fileID: 0}
    NoCondition: 0
  - Content: "\uACF5\uAE09\uB9DD \uC815\uC0C1\uD654 \uC808\uCC28\uB97C \uC644\uB8CC\uD558\uC600\uC2B5\uB2C8\uB2E4.\r\n{Title}
      \uB204\uCD9C \uB300\uC751 \uD6C8\uB828\uC744 \uC885\uB8CC\uD569\uB2C8\uB2E4."
    Voice: {fileID: 0}
    NoCondition: 0
  WaitTime: 15
